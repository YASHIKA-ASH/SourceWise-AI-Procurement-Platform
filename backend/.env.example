# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# Neon PostgreSQL. SQLAlchemy automatically converts postgresql:// to postgresql+psycopg://.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# JWT and first administrator
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=SourceWise Administrator

# Redis. Local Docker Compose uses redis://redis:6379/0 inside containers.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

# AWS S3. On EC2, prefer an IAM instance role instead of static AWS keys.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_KEY_PREFIX=sourcewise
S3_PRESIGNED_EXPIRY_SECONDS=900
S3_SSE_ALGORITHM=AES256
S3_MAX_UPLOAD_BYTES=52428800

# Gemini and Chroma
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHROMA_PATH=./chroma_db
