[Unit]
Description=SourceWise Backend for Vercel Frontend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sourcewise
EnvironmentFile=/opt/sourcewise/.deploy.env
ExecStart=/usr/bin/docker compose --env-file /opt/sourcewise/.deploy.env -f docker-compose.vercel-ec2.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file /opt/sourcewise/.deploy.env -f docker-compose.vercel-ec2.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
