# Stable API hostname that points to the EC2 Elastic IP.
# Example: api.yourdomain.com
API_DOMAIN=api.yourdomain.com

# Email used by Caddy for automatic HTTPS certificate management.
TLS_EMAIL=you@example.com

# Use a long URL-safe value. Avoid spaces and characters requiring URL encoding.
REDIS_PASSWORD=replace-with-a-long-random-value
